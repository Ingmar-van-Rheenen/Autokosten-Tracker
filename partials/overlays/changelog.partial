<!-- CHANGELOG OVERLAY -->
<div id="changelog-overlay" class="changelog-overlay hidden" role="dialog" aria-modal="true">
  <div class="changelog-backdrop" id="changelog-backdrop"></div>
  <div class="changelog-card">
    <div class="changelog-handel"></div>
    <div class="changelog-kop">
      <span class="changelog-badge">NIEUW</span>
      <span class="changelog-versie" id="cl-versie">v1.5</span>
      <span class="changelog-datum" id="cl-datum"></span>
    </div>
    <div class="changelog-titel">Wat is er nieuw?</div>
    <ul class="changelog-lijst" id="cl-lijst"></ul>
    <button class="changelog-sluit-btn" id="cl-sluit-btn">Sluiten ✓</button>
  </div>
</div>
