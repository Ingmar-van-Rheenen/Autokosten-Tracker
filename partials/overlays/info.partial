<!-- INFO OVERLAY (gedeeld component — binnen screen-app voor correcte stacking) -->
<div id="info-overlay" class="info-overlay hidden" role="dialog" aria-modal="true">
  <div class="io-backdrop" id="info-overlay-backdrop"></div>
  <div class="io-panel">
    <div class="io-handel"></div>
    <div class="io-visual" id="info-overlay-icoon"></div>
    <div class="io-content">
      <div class="io-chip" id="info-overlay-chip">INFO</div>
      <div class="io-titel" id="info-overlay-titel">—</div>
      <div class="io-tekst" id="info-overlay-tekst">—</div>
      <button class="io-btn" id="info-overlay-btn">Begrepen</button>
    </div>
  </div>
</div>
