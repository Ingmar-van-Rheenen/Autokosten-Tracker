<!-- INSTALL OVERLAY (iOS & Android, position:fixed op viewport) -->
<div id="install-overlay" class="install-overlay hidden">
  <div class="install-overlay-bd" id="install-overlay-bd"></div>
  <div class="install-sheet">
    <button class="install-sluit" id="install-sluit">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="install-app-icon">
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="48" height="48" rx="12" fill="#2a3a2c"/>
        <path d="M10 28 L15 18 H33 L38 28 V34 H10 Z" fill="#4e7d52"/>
        <path d="M14 28 L18 20 H30 L34 28" fill="#5e9464"/>
        <rect x="10" y="28" width="28" height="7" rx="2" fill="#4e7d52"/>
        <circle cx="17" cy="35" r="4" fill="#1a251c"/>
        <circle cx="17" cy="35" r="2" fill="#3a5a3c"/>
        <circle cx="31" cy="35" r="4" fill="#1a251c"/>
        <circle cx="31" cy="35" r="2" fill="#3a5a3c"/>
        <rect x="20" y="21" width="8" height="5" rx="1" fill="rgba(255,255,255,0.15)"/>
      </svg>
    </div>

    <div class="install-titel">Installeer Vroom als app</div>
    <div class="install-sub">Voeg Vroom toe aan je beginscherm voor de snelste ervaring — ook offline beschikbaar.</div>

    <!-- Android: directe installatieknop -->
    <div id="install-android-sectie" class="install-sectie hidden">
      <button id="pwa-install-btn" class="install-primaire-btn">Toevoegen aan beginscherm</button>
    </div>

    <!-- iOS: stap-voor-stap instructies -->
    <div id="install-ios-sectie" class="install-sectie hidden">
      <ol class="install-stappen">
        <li>
          <span class="install-stap-nr">1</span>
          <span>Tik op het <strong>Deel</strong>-icoon
            <svg class="install-share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v9M9 5l3-3 3 3"/><rect x="3" y="11" width="18" height="10" rx="2"/>
            </svg>
            onderaan je scherm
          </span>
        </li>
        <li>
          <span class="install-stap-nr">2</span>
          <span>Kies <strong>'Zet op beginscherm'</strong></span>
        </li>
        <li>
          <span class="install-stap-nr">3</span>
          <span>Tik op <strong>'Voeg toe'</strong></span>
        </li>
      </ol>
      <div class="install-pijl">▼</div>
    </div>

    <button class="install-later" id="install-later">Misschien later</button>
  </div>
</div>
