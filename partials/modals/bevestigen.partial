<!-- MODAL: BEVESTIGEN (vervangt browser-confirm) -->
<div id="modal-confirm" class="modal hidden" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="cm-backdrop"></div>
  <div class="modal-sheet cm-sheet">
    <div class="modal-handel"></div>
    <h3 class="cm-titel">Weet je het zeker?</h3>
    <p class="cm-tekst"></p>
    <div class="cm-acties">
      <button type="button" class="btn-form-sec cm-annuleer">Annuleer</button>
      <button type="button" class="btn-form-primary cm-bevestig">Bevestig</button>
    </div>
  </div>
</div>
