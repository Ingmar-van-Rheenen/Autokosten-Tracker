<!-- MODAL: AFREKENEN -->
<div id="modal-afreken" class="modal hidden" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-sheet">
    <div class="modal-handel"></div>
    <div class="modal-kop">
      <h3 class="modal-titel">Afrekenen</h3>
    </div>
    <div class="afreken-saldo">
      <div class="afreken-saldo-lbl" id="afreken-saldo-lbl">Saldo</div>
      <div class="afreken-saldo-val" id="afreken-saldo-val">€ 0,00</div>
      <div class="afreken-saldo-uitleg" id="afreken-saldo-uitleg"></div>
    </div>
    <div class="afreken-knoppen">
      <a id="afreken-whatsapp" class="afreken-btn afreken-btn--whatsapp" href="#" target="_blank" rel="noopener">
        <span class="afreken-btn-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
        </span>
        <span>WhatsApp</span>
      </a>
      <a id="afreken-tikkie" class="afreken-btn afreken-btn--tikkie hidden" href="#" target="_blank" rel="noopener">
        <span>Tikkie</span>
      </a>
      <a id="afreken-bunq" class="afreken-btn afreken-btn--bunq hidden" href="#" target="_blank" rel="noopener">
        <span>bunq</span>
      </a>
      <a id="afreken-revolut" class="afreken-btn afreken-btn--revolut hidden" href="#" target="_blank" rel="noopener">
        <span>Revolut</span>
      </a>
    </div>
    <div class="afreken-methode-rij">
      <label class="afreken-methode-lbl" for="afreken-methode">Methode</label>
      <select id="afreken-methode" class="afreken-methode-select">
        <option value="tikkie">Tikkie</option>
        <option value="bunq">bunq</option>
        <option value="revolut">Revolut</option>
        <option value="cash">Cash</option>
        <option value="overschrijving">Overschrijving</option>
        <option value="overig">Overig</option>
      </select>
    </div>
    <button id="afreken-markeer" class="afreken-bevestig">Markeer als afgerekend</button>
  </div>
</div>
