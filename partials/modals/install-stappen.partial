<!-- MODAL: INSTALL STAPPEN — zelfde structuur als InfoOverlay -->
<div id="install-stappen-overlay" class="info-overlay hidden" role="dialog" aria-modal="true">
  <div class="io-backdrop" id="install-stappen-backdrop"></div>
  <div class="io-panel">
    <div class="io-handel"></div>
    <div class="io-visual">
      <div class="install-stappen-icon">
        <img src="icons/icon-192.png" alt="Tanklog" width="64" height="64" />
      </div>
    </div>
    <div class="io-content">
      <div class="io-chip install-stappen-chip">INSTALLEER</div>
      <div class="io-titel">Toevoegen aan beginscherm</div>

      <div class="install-platform-tabs" role="tablist">
        <button class="install-platform-tab actief" data-platform="ios" role="tab" aria-selected="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          iPhone / iPad
        </button>
        <button class="install-platform-tab" data-platform="android" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.341a5.53 5.53 0 0 1-5.53 5.53 5.53 5.53 0 0 1-5.53-5.53 5.53 5.53 0 0 1 5.53-5.53 5.53 5.53 0 0 1 5.53 5.53zm-5.53-13.18A13.18 13.18 0 0 0 .813 15.341h3.36a9.82 9.82 0 0 1 9.82-9.82 9.82 9.82 0 0 1 9.82 9.82h3.36A13.18 13.18 0 0 0 11.993 2.161z"/>
          </svg>
          Android
        </button>
      </div>

      <ol class="install-stappen install-stappen-paneel" data-paneel="ios">
        <li>
          <span class="install-stap-nr">1</span>
          <span>Tik op het <strong>Deel</strong>-icoon
            <svg class="install-share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2v9M9 5l3-3 3 3"/><rect x="3" y="11" width="18" height="10" rx="2"/>
            </svg>
            onderaan je scherm
          </span>
        </li>
        <li>
          <span class="install-stap-nr">2</span>
          <span>Scroll en kies <strong>'Zet op beginscherm'</strong></span>
        </li>
        <li>
          <span class="install-stap-nr">3</span>
          <span>Tik op <strong>'Voeg toe'</strong> rechtsboven</span>
        </li>
      </ol>

      <ol class="install-stappen install-stappen-paneel hidden" data-paneel="android">
        <li>
          <span class="install-stap-nr">1</span>
          <span>Tik op het <strong>menu</strong>-icoon
            <svg class="install-share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="12" cy="6" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="18" r="1.8"/>
            </svg>
            rechtsboven in Chrome
          </span>
        </li>
        <li>
          <span class="install-stap-nr">2</span>
          <span>Kies <strong>'Toevoegen aan beginscherm'</strong> of <strong>'App installeren'</strong></span>
        </li>
        <li>
          <span class="install-stap-nr">3</span>
          <span>Tik op <strong>'Toevoegen'</strong> om te bevestigen</span>
        </li>
      </ol>

      <button id="install-stappen-sluit" class="io-btn">Begrepen</button>
    </div>
  </div>
</div>
